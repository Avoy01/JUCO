          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="ap3d" edge="1" parent="1" source="p3de" style="edgeStyle=orthogonalEdgeStyle;strokeColor=#E65100;strokeWidth=1.5;" target="p3out">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="p4bg" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FCE4EC;strokeColor=#880E4F;strokeWidth=2.5;arcSize=4;verticalAlign=top;" value="" vertex="1">
          <mxGeometry height="680" width="350" x="1400" y="60" as="geometry" />
        </mxCell>
        <mxCell id="p4hd" parent="1" style="text;html=1;align=center;verticalAlign=middle;fontSize=13;fontStyle=1;fontColor=#FFFFFF;strokeColor=none;fillColor=#880E4F;rounded=1;arcSize=6;" value="PHASE 4 — Safe Abstention Protocol" vertex="1">
          <mxGeometry height="38" width="330" x="1410" y="70" as="geometry" />
        </mxCell>
        <mxCell id="p4ent" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#880E4F;strokeWidth=1.5;fontSize=10;align=left;spacingLeft=10;" value="&lt;b&gt;Shannon Entropy&lt;/b&gt;&lt;br&gt;&lt;br&gt;H&lt;sub&gt;i&lt;/sub&gt; = −Σ&lt;sub&gt;k&lt;/sub&gt; p̂&lt;sub&gt;ik&lt;/sub&gt; ln( p̂&lt;sub&gt;ik&lt;/sub&gt; + ε )&lt;br&gt;&lt;br&gt;&lt;font color=&#39;#880E4F&#39;&gt;Wide fuzzy interval → high H&lt;sub&gt;i&lt;/sub&gt;&lt;/font&gt;&lt;br&gt;&lt;font color=&#39;#1B5E20&#39;&gt;Crisp features → low H&lt;sub&gt;i&lt;/sub&gt;&lt;/font&gt;" vertex="1">
          <mxGeometry height="110" width="326" x="1412" y="128" as="geometry" />
        </mxCell>
        <mxCell id="p4cal" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FCE4EC;strokeColor=#880E4F;strokeWidth=1.5;fontSize=10;align=left;spacingLeft=10;" value="&lt;b&gt;Threshold Calibration (on Cal. Set)&lt;/b&gt;&lt;br&gt;&lt;br&gt;Sort samples by H&lt;sub&gt;i&lt;/sub&gt; ascending&lt;br&gt;Walk sorted prefix; find largest k s.t.&lt;br&gt;error rate = 1 − (Σ correct / k) ≤ ε&lt;sub&gt;max&lt;/sub&gt; = 5%&lt;br&gt;τ* = H&lt;sub&gt;(k)&lt;/sub&gt; at that boundary" vertex="1">
          <mxGeometry height="110" width="326" x="1412" y="254" as="geometry" />
        </mxCell>
        <mxCell id="p4aurc" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#880E4F;fontSize=10;align=left;spacingLeft=10;" value="AURC = ∫ r(κ) dκ&lt;br&gt;Lower AURC = better selective prediction&lt;br&gt;Risk@90 = error rate on top-confidence 90%" vertex="1">
          <mxGeometry height="64" width="326" x="1412" y="380" as="geometry" />
        </mxCell>
        <mxCell id="p4dec" parent="1" style="rhombus;whiteSpace=wrap;html=1;fillColor=#FCE4EC;strokeColor=#880E4F;strokeWidth=2;fontSize=13;fontStyle=1;" value="H&lt;sub&gt;i&lt;/sub&gt; &gt; τ* ?" vertex="1">
          <mxGeometry height="80" width="150" x="1494" y="462" as="geometry" />
        </mxCell>
        <mxCell id="p4pr" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#1B5E20;strokeColor=#1B5E20;strokeWidth=2;fontColor=#FFFFFF;fontSize=11;align=center;" value="&lt;b&gt;PREDICT&lt;/b&gt;&lt;br&gt;Issue calibrated&lt;br&gt;risk score p̂&lt;sub&gt;i&lt;/sub&gt;&lt;br&gt;(AUROC, DCA)" vertex="1">
          <mxGeometry height="80" width="130" x="1408" y="578" as="geometry" />
        </mxCell>
        <mxCell id="p4ab" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#B71C1C;strokeColor=#B71C1C;strokeWidth=2;fontColor=#FFFFFF;fontSize=11;align=center;" value="&lt;b&gt;ABSTAIN&lt;/b&gt;&lt;br&gt;Defer to&lt;br&gt;clinician review&lt;br&gt;(AURC metric)" vertex="1">
          <mxGeometry height="80" width="130" x="1596" y="578" as="geometry" />
        </mxCell>
        <mxCell id="ap4a" edge="1" parent="1" source="p4ent" style="edgeStyle=orthogonalEdgeStyle;strokeColor=#880E4F;strokeWidth=1.5;" target="p4cal">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
