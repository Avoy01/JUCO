        <mxCell id="tt" parent="1" style="text;html=1;align=center;verticalAlign=middle;fontSize=15;fontStyle=1;fontColor=#1A237E;strokeColor=none;fillColor=none;" value="JUCO Four-Phase Pipeline: Missing Data → Interval → Fuzzy → Soft Routing → Entropy → Abstention" vertex="1">
          <mxGeometry height="32" width="1800" x="60" y="16" as="geometry" />
        </mxCell>
        <mxCell id="inp" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF9C4;strokeColor=#F57F17;strokeWidth=2;fontSize=11;align=center;arcSize=10;" value="&lt;b&gt;EHR Input&lt;/b&gt;&lt;br&gt;X ∈ (ℝ ∪ {NaN})&lt;sup&gt;n×d&lt;/sup&gt;&lt;br&gt;&lt;font color=&#39;#B71C1C&#39;&gt;MNAR missingness&lt;br&gt;P(M|x) ≠ P(M)&lt;/font&gt;" vertex="1">
          <mxGeometry height="88" width="148" x="30" y="360" as="geometry" />
        </mxCell>
        <mxCell id="p1bg" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E3F2FD;strokeColor=#1565C0;strokeWidth=2.5;arcSize=4;verticalAlign=top;" value="" vertex="1">
          <mxGeometry height="680" width="340" x="210" y="60" as="geometry" />
        </mxCell>
        <mxCell id="p1hd" parent="1" style="text;html=1;align=center;verticalAlign=middle;fontSize=13;fontStyle=1;fontColor=#FFFFFF;strokeColor=none;fillColor=#1565C0;rounded=1;arcSize=6;" value="PHASE 1 — Adaptive Quantile Imputation" vertex="1">
          <mxGeometry height="38" width="320" x="220" y="70" as="geometry" />
        </mxCell>
        <mxCell id="p1obs" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#1565C0;fontSize=10;align=center;" value="Observed: M&lt;sub&gt;ij&lt;/sub&gt; = 0&lt;br&gt;x&lt;sub&gt;ij&lt;/sub&gt; passed through" vertex="1">
          <mxGeometry height="48" width="138" x="228" y="128" as="geometry" />
        </mxCell>
        <mxCell id="p1mis" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFCDD2;strokeColor=#C62828;fontSize=10;align=center;" value="Missing: M&lt;sub&gt;ij&lt;/sub&gt; = 1&lt;br&gt;needs imputation" vertex="1">
          <mxGeometry height="48" width="138" x="384" y="128" as="geometry" />
        </mxCell>
        <mxCell id="p1lgb" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#1565C0;strokeWidth=1.5;fontSize=10;align=center;" value="&lt;b&gt;LightGBM Quantile Regression&lt;/b&gt;&lt;br&gt;3 models per feature j:&lt;br&gt;α ∈ {α&lt;sub&gt;L&lt;/sub&gt;, 0.5, α&lt;sub&gt;U&lt;/sub&gt;}&lt;br&gt;&lt;br&gt;Minimise weighted pinball loss:&lt;br&gt;ρ&lt;sub&gt;α&lt;/sub&gt;(u) = u(α − 𝟙&lt;sub&gt;u&lt;0&lt;/sub&gt;)&lt;br&gt;&lt;br&gt;Class weights: w&lt;sub&gt;k&lt;/sub&gt; = N / (K·n&lt;sub&gt;k&lt;/sub&gt;)" vertex="1">
          <mxGeometry height="130" width="300" x="240" y="210" as="geometry" />
        </mxCell>
        <mxCell id="p1out" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#1565C0;strokeColor=#0D47A1;strokeWidth=2;fontColor=#FFFFFF;fontSize=11;align=center;" value="&lt;b&gt;Imputation Interval&lt;/b&gt;&lt;br&gt;( q&lt;sup&gt;L&lt;/sup&gt;&lt;sub&gt;ij&lt;/sub&gt;,  q&lt;sup&gt;M&lt;/sup&gt;&lt;sub&gt;ij&lt;/sub&gt;,  q&lt;sup&gt;U&lt;/sup&gt;&lt;sub&gt;ij&lt;/sub&gt; )&lt;br&gt;&lt;br&gt;&lt;font color=&#39;#E3F2FD&#39;&gt;Width = imputation uncertainty&lt;/font&gt;&lt;br&gt;&lt;font color=&#39;#E3F2FD&#39;&gt;Wide → uncertain    Narrow → confident&lt;/font&gt;" vertex="1">
          <mxGeometry height="88" width="300" x="240" y="390" as="geometry" />
        </mxCell>
        <mxCell id="p1de" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF9C4;strokeColor=#F9A825;strokeWidth=1.5;fontSize=10;align=center;" value="α&lt;sub&gt;L&lt;/sub&gt; ∈ [0.05, 0.35]   α&lt;sub&gt;U&lt;/sub&gt; ∈ [0.65, 0.95]&lt;br&gt;&lt;i&gt;both set by DE (Phase 3)&lt;/i&gt;" vertex="1">
          <mxGeometry height="44" width="300" x="240" y="500" as="geometry" />
        </mxCell>
        <mxCell id="p1obn" parent="1" style="text;html=1;strokeColor=#1565C0;fillColor=#E3F2FD;align=center;verticalAlign=middle;whiteSpace=wrap;rounded=1;fontSize=9;fontColor=#0D47A1;" value="Observed x&lt;sub&gt;ij&lt;/sub&gt; → a=b=c=d=x&lt;sub&gt;ij&lt;/sub&gt; (crisp, no imputation)" vertex="1">
          <mxGeometry height="34" width="300" x="240" y="560" as="geometry" />
        </mxCell>
