        </mxCell>
        <mxCell id="p2bg" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E8F5E9;strokeColor=#2E7D32;strokeWidth=2.5;arcSize=4;verticalAlign=top;" value="" vertex="1">
          <mxGeometry height="680" width="340" x="600" y="60" as="geometry" />
        </mxCell>
        <mxCell id="p2hd" parent="1" style="text;html=1;align=center;verticalAlign=middle;fontSize=13;fontStyle=1;fontColor=#FFFFFF;strokeColor=none;fillColor=#2E7D32;rounded=1;arcSize=6;" value="PHASE 2 — Proportional Fuzzy Transformation" vertex="1">
          <mxGeometry height="38" width="320" x="610" y="70" as="geometry" />
        </mxCell>
        <mxCell id="p2con" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#2E7D32;strokeWidth=1.5;fontSize=10;align=left;spacingLeft=10;" value="&lt;b&gt;Trapezoid Construction&lt;/b&gt;&lt;br&gt;&lt;br&gt;a&lt;sub&gt;ij&lt;/sub&gt; = q&lt;sup&gt;L&lt;/sup&gt;&lt;sub&gt;ij&lt;/sub&gt;&lt;br&gt;d&lt;sub&gt;ij&lt;/sub&gt; = q&lt;sup&gt;U&lt;/sup&gt;&lt;sub&gt;ij&lt;/sub&gt;&lt;br&gt;b&lt;sub&gt;ij&lt;/sub&gt; = max(a,  q&lt;sup&gt;M&lt;/sup&gt; − η·(q&lt;sup&gt;U&lt;/sup&gt;−q&lt;sup&gt;L&lt;/sup&gt;))&lt;br&gt;c&lt;sub&gt;ij&lt;/sub&gt; = min(d,  q&lt;sup&gt;M&lt;/sup&gt; + η·(q&lt;sup&gt;U&lt;/sup&gt;−q&lt;sup&gt;L&lt;/sup&gt;))" vertex="1">
          <mxGeometry height="118" width="304" x="618" y="128" as="geometry" />
        </mxCell>
        <mxCell id="p2eta" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF9C4;strokeColor=#F9A825;strokeWidth=1.5;fontSize=10;align=center;" value="η ∈ [0, 0.5]  ← set by DE&lt;br&gt;Small η → wide flat core (interval-like)&lt;br&gt;Large η → peaked (near-point imputation)" vertex="1">
          <mxGeometry height="60" width="304" x="618" y="262" as="geometry" />
        </mxCell>
        <mxCell id="p2drv" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F1F8E9;strokeColor=#2E7D32;fontSize=10;align=left;spacingLeft=10;" value="&lt;b&gt;Derived quantities used downstream:&lt;/b&gt;&lt;br&gt;centroid = (a+b+c+d) / 4&lt;br&gt;uncertainty = d − a" vertex="1">
          <mxGeometry height="68" width="304" x="618" y="338" as="geometry" />
        </mxCell>
        <mxCell id="p2mem" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#2E7D32;fontSize=10;align=left;spacingLeft=10;" value="Membership function μ(x):&lt;br&gt;0   if x &lt; a or x &gt; d&lt;br&gt;(x−a)/(b−a)   if a ≤ x &lt; b&lt;br&gt;1   if b ≤ x ≤ c&lt;br&gt;(d−x)/(d−c)   if c &lt; x ≤ d" vertex="1">
          <mxGeometry height="100" width="304" x="618" y="420" as="geometry" />
        </mxCell>
        <mxCell id="p2out" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#2E7D32;strokeColor=#1B5E20;strokeWidth=2;fontColor=#FFFFFF;fontSize=11;align=center;" value="&lt;b&gt;Trapezoidal Fuzzy Number&lt;/b&gt;&lt;br&gt;x̃&lt;sub&gt;ij&lt;/sub&gt; = (a, b, c, d)&lt;br&gt;&lt;br&gt;&lt;font color=&#39;#E8F5E9&#39;&gt;Support width d−a encodes uncertainty&lt;/font&gt;&lt;br&gt;&lt;font color=&#39;#E8F5E9&#39;&gt;Crisp obs: a=b=c=d=x&lt;sub&gt;ij&lt;/sub&gt;&lt;/font&gt;" vertex="1">
          <mxGeometry height="88" width="284" x="628" y="538" as="geometry" />
        </mxCell>
        <mxCell id="ap2a" edge="1" parent="1" source="p2con" style="edgeStyle=orthogonalEdgeStyle;strokeColor=#2E7D32;strokeWidth=1.5;" target="p2eta">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="ap2b" edge="1" parent="1" source="p2eta" style="edgeStyle=orthogonalEdgeStyle;strokeColor=#2E7D32;strokeWidth=1.5;" target="p2drv">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="ap2c" edge="1" parent="1" source="p2drv" style="edgeStyle=orthogonalEdgeStyle;strokeColor=#2E7D32;strokeWidth=1.5;" target="p2mem">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="ap2d" edge="1" parent="1" source="p2mem" style="edgeStyle=orthogonalEdgeStyle;strokeColor=#2E7D32;strokeWidth=1.5;" target="p2out">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="p3bg" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF3E0;strokeColor=#E65100;strokeWidth=2.5;arcSize=4;verticalAlign=top;" value="" vertex="1">
          <mxGeometry height="680" width="360" x="990" y="60" as="geometry" />
        </mxCell>
        <mxCell id="p3hd" parent="1" style="text;html=1;align=center;verticalAlign=middle;fontSize=13;fontStyle=1;fontColor=#FFFFFF;strokeColor=none;fillColor=#E65100;rounded=1;arcSize=6;" value="PHASE 3 — Fuzzy Decision Forest + DE" vertex="1">
          <mxGeometry height="38" width="340" x="1000" y="70" as="geometry" />
        </mxCell>
        <mxCell id="p3sr" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#E65100;strokeWidth=1.5;fontSize=10;align=left;spacingLeft=10;" value="&lt;b&gt;Soft Routing at Each Internal Node&lt;/b&gt;&lt;br&gt;&lt;br&gt;sharpness = 5 / (uncertainty + t&lt;sub&gt;width&lt;/sub&gt; + ε)&lt;br&gt;μ&lt;sub&gt;L&lt;/sub&gt; = σ( sharpness · (t&lt;sub&gt;center&lt;/sub&gt; − centroid) )&lt;br&gt;μ&lt;sub&gt;R&lt;/sub&gt; = 1 − μ&lt;sub&gt;L&lt;/sub&gt;&lt;br&gt;&lt;br&gt;&lt;font color=&#39;#BF360C&#39;&gt;Wide interval → low sharpness → diffuse split&lt;/font&gt;&lt;br&gt;&lt;font color=&#39;#1B5E20&#39;&gt;Crisp obs → high sharpness → hard split&lt;/font&gt;" vertex="1">
          <mxGeometry height="138" width="336" x="1002" y="128" as="geometry" />
        </mxCell>
        <mxCell id="p3sc" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF3E0;strokeColor=#E65100;strokeWidth=1.5;fontSize=10;align=left;spacingLeft=10;" value="&lt;b&gt;Split Criterion: max Fuzzy Info Gain&lt;/b&gt;&lt;br&gt;H&lt;sub&gt;fuzzy&lt;/sub&gt; = −Σ p̃&lt;sub&gt;k&lt;/sub&gt; log&lt;sub&gt;2&lt;/sub&gt;(p̃&lt;sub&gt;k&lt;/sub&gt;)&lt;br&gt;ΔH = H(w,y) − Σ w·μ·H(w∘μ,y) / Σw&lt;br&gt;Thresholds at {15,30,45,50,55,70,85} percentile" vertex="1">
          <mxGeometry height="88" width="336" x="1002" y="280" as="geometry" />
        </mxCell>
        <mxCell id="p3fo" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#E65100;strokeWidth=1.5;fontSize=10;align=left;spacingLeft=10;" value="&lt;b&gt;K = 180 Trees&lt;/b&gt;&lt;br&gt;Balanced bootstrap (equal pos/neg per tree)&lt;br&gt;Feature subsample ratio r&lt;sub&gt;sub&lt;/sub&gt; = 70%&lt;br&gt;Leaf: p̂&lt;sup&gt;ℓ&lt;/sup&gt;&lt;sub&gt;k&lt;/sub&gt; = Σ w&lt;sup&gt;ℓ&lt;/sup&gt;&lt;sub&gt;(y=k)&lt;/sub&gt; / Σ w&lt;sup&gt;ℓ&lt;/sup&gt;&lt;br&gt;Forest: p̂&lt;sub&gt;i&lt;/sub&gt; = (1/K) Σ p̂&lt;sup&gt;(k)&lt;/sup&gt;&lt;sub&gt;i&lt;/sub&gt;" vertex="1">
          <mxGeometry height="100" width="336" x="1002" y="382" as="geometry" />
        </mxCell>
        <mxCell id="p3de" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF9C4;strokeColor=#F9A825;strokeWidth=2;fontSize=10;align=left;spacingLeft=10;" value="&lt;b&gt;Two-Stage Differential Evolution&lt;/b&gt;&lt;br&gt;θ = (α&lt;sub&gt;L&lt;/sub&gt;, α&lt;sub&gt;U&lt;/sub&gt;, η, d&lt;sub&gt;max&lt;/sub&gt;, n&lt;sub&gt;min&lt;/sub&gt;)&lt;br&gt;ℒ(θ) = L&lt;sub&gt;class&lt;/sub&gt; + λ&lt;sub&gt;1&lt;/sub&gt;(=0.2)·MPIW&lt;sub&gt;norm&lt;/sub&gt; + λ&lt;sub&gt;2&lt;/sub&gt;(=2.0)·coverage_gap&lt;br&gt;Stage 1: proxy K=20 trees, 2,000 samples (global)&lt;br&gt;Stage 2: proxy K=40 trees, 7,000 samples, seed from Stage 1 (local)&lt;br&gt;&lt;font color=&#39;#BF360C&#39;&gt;Run once on Fold 1 → θ* = (α&lt;sub&gt;L&lt;/sub&gt;=0.0555, α&lt;sub&gt;U&lt;/sub&gt;=0.9384, η=0.2869, d&lt;sub&gt;max&lt;/sub&gt;=6, n&lt;sub&gt;min&lt;/sub&gt;=33) frozen for all folds + eICU&lt;/font&gt;" vertex="1">
          <mxGeometry height="118" width="336" x="1002" y="496" as="geometry" />
        </mxCell>
        <mxCell id="p3out" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E65100;strokeColor=#BF360C;strokeWidth=2;fontColor=#FFFFFF;fontSize=11;align=center;" value="&lt;b&gt;Calibrated Probability Vector p̂&lt;sub&gt;i&lt;/sub&gt;&lt;/b&gt;&lt;br&gt;+ isotonic calibration (post-hoc)" vertex="1">
          <mxGeometry height="56" width="300" x="1020" y="628" as="geometry" />
        </mxCell>
        <mxCell id="ap3a" edge="1" parent="1" source="p3sr" style="edgeStyle=orthogonalEdgeStyle;strokeColor=#E65100;strokeWidth=1.5;" target="p3sc">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="ap3b" edge="1" parent="1" source="p3sc" style="edgeStyle=orthogonalEdgeStyle;strokeColor=#E65100;strokeWidth=1.5;" target="p3fo">
