        <mxCell id="2Eg8ceEiwQ1pqdhiCGCj-12" parent="1" style="text;html=1;align=center;verticalAlign=middle;fontSize=13;fontStyle=1;fontColor=#FFFFFF;strokeColor=none;fillColor=#2E7D32;rounded=1;arcSize=8;labelBackgroundColor=none;" value="Phase 2" vertex="1">
          <mxGeometry height="34" width="206" x="490" y="80" as="geometry" />
        </mxCell>
        <mxCell id="2Eg8ceEiwQ1pqdhiCGCj-13" parent="1" style="text;html=1;align=center;verticalAlign=middle;fontSize=11;fontStyle=2;fontColor=#2E7D32;strokeColor=none;fillColor=none;labelBackgroundColor=none;" value="&lt;font style=&quot;font-size: 12px;&quot;&gt;Proportional Fuzzy Transformation&lt;/font&gt;" vertex="1">
          <mxGeometry height="20" width="224" x="472" y="118" as="geometry" />
        </mxCell>
        <mxCell id="2Eg8ceEiwQ1pqdhiCGCj-14" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#A5D6A7;strokeWidth=1;fontSize=11;align=center;verticalAlign=middle;labelBackgroundColor=none;" value="&lt;font style=&quot;font-size: 13px;&quot;&gt;Maps [q&lt;sup style=&quot;&quot;&gt;L&lt;/sup&gt;, q&lt;sup style=&quot;&quot;&gt;M&lt;/sup&gt;, q&lt;sup style=&quot;&quot;&gt;U&lt;/sup&gt;] → trapezoid&amp;nbsp;&lt;/font&gt;&lt;div&gt;&lt;font style=&quot;font-size: 13px;&quot;&gt;(a, b, c, d)&lt;br&gt;a = q&lt;sup style=&quot;&quot;&gt;L&lt;/sup&gt;, d = q&lt;sup style=&quot;&quot;&gt;U&lt;/sup&gt;; b, c via proportion factor η&lt;br&gt;Small η → wide flat core;&amp;nbsp;&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;font-size: 13px;&quot;&gt;large η → near-point&lt;/font&gt;&lt;/div&gt;" vertex="1">
          <mxGeometry height="122" width="210" x="490" y="138" as="geometry" />
        </mxCell>
        <mxCell id="2Eg8ceEiwQ1pqdhiCGCj-15" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#2E7D32;strokeColor=#1B5E20;fontColor=#FFFFFF;fontSize=11;align=center;verticalAlign=middle;labelBackgroundColor=none;" value="&lt;font style=&quot;font-size: 12px;&quot;&gt;Trapezoidal fuzzy number&lt;/font&gt;&lt;div&gt;&lt;font style=&quot;font-size: 12px;&quot;&gt;&lt;b&gt;x̃&lt;sub&gt;ij&lt;/sub&gt; = (a, b, c, d)&lt;/b&gt;&lt;br&gt;Support width d−a encodes uncertainty&lt;br&gt;Crisp observed entries:&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;font-size: 12px;&quot;&gt;&amp;nbsp;a = b = c = d = x&lt;sub&gt;ij&lt;/sub&gt;&lt;/font&gt;&lt;/div&gt;" vertex="1">
          <mxGeometry height="108" width="204" x="493" y="270" as="geometry" />
        </mxCell>
        <mxCell id="2Eg8ceEiwQ1pqdhiCGCj-16" parent="1" style="text;html=1;align=center;verticalAlign=middle;fontSize=10;fontStyle=2;fontColor=#2E7D32;strokeColor=none;fillColor=none;labelBackgroundColor=none;" value="&lt;font style=&quot;font-size: 11px;&quot;&gt;η jointly tuned by Differential Evolution&lt;/font&gt;" vertex="1">
          <mxGeometry height="20" width="218" x="482" y="380" as="geometry" />
        </mxCell>
