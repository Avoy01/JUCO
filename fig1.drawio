        </mxCell>
        <mxCell id="2Eg8ceEiwQ1pqdhiCGCj-7" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#90CAF9;strokeWidth=1;fontSize=11;align=center;verticalAlign=middle;labelBackgroundColor=none;" value="&lt;font style=&quot;font-size: 13px;&quot;&gt;LightGBM quantile regression&lt;br&gt;3 models per feature j: quantile levels α&lt;sub style=&quot;&quot;&gt;L&lt;/sub&gt;, 0.5, α&lt;sub style=&quot;&quot;&gt;U&lt;/sub&gt;&lt;br&gt;Inverse-frequency class weights&lt;/font&gt;" vertex="1">
          <mxGeometry height="124" width="158" x="238" y="138" as="geometry" />
        </mxCell>
        <mxCell id="2Eg8ceEiwQ1pqdhiCGCj-8" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#1565C0;strokeColor=#0D47A1;fontColor=#FFFFFF;fontSize=11;align=center;verticalAlign=middle;labelBackgroundColor=none;" value="&lt;font style=&quot;font-size: 12px;&quot;&gt;Output: &lt;b style=&quot;&quot;&gt;[q&lt;sup&gt;L&lt;/sup&gt;, q&lt;sup&gt;M&lt;/sup&gt;, q&lt;sup&gt;U&lt;/sup&gt;]&lt;/b&gt; per missing entry&lt;br&gt;Interval width = imputation uncertainty&lt;br&gt;Observed entries passed through unchanged&lt;/font&gt;" vertex="1">
          <mxGeometry height="100" width="206" x="214" y="270" as="geometry" />
        </mxCell>
        <mxCell id="2Eg8ceEiwQ1pqdhiCGCj-9" parent="1" style="text;html=1;align=center;verticalAlign=middle;fontSize=10;fontStyle=2;fontColor=#1565C0;strokeColor=none;fillColor=none;labelBackgroundColor=none;" value="&lt;font style=&quot;font-size: 11px;&quot;&gt;α&lt;sub&gt;L&lt;/sub&gt;, α&lt;sub&gt;U&lt;/sub&gt; jointly tuned by Differential Evolution&lt;/font&gt;" vertex="1">
          <mxGeometry height="20" width="270" x="178" y="380" as="geometry" />
        </mxCell>
        <mxCell id="2Eg8ceEiwQ1pqdhiCGCj-11" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E8F5E9;strokeColor=#2E7D32;strokeWidth=2.5;arcSize=5;labelBackgroundColor=none;" value="" vertex="1">
