        <mxCell id="2Eg8ceEiwQ1pqdhiCGCj-20" parent="1" style="text;html=1;align=center;verticalAlign=middle;fontSize=11;fontStyle=2;fontColor=#6A1B9A;strokeColor=none;fillColor=none;labelBackgroundColor=none;" value="&lt;font style=&quot;font-size: 12px;&quot;&gt;Fuzzy Decision Forest&lt;/font&gt;" vertex="1">
          <mxGeometry height="20" width="216" x="754" y="118" as="geometry" />
        </mxCell>
        <mxCell id="2Eg8ceEiwQ1pqdhiCGCj-21" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#CE93D8;strokeWidth=1;fontSize=11;align=center;verticalAlign=middle;labelBackgroundColor=none;" value="&lt;font style=&quot;font-size: 13px;&quot;&gt;Soft node routing:&amp;nbsp;&lt;/font&gt;&lt;div&gt;&lt;font style=&quot;font-size: 13px;&quot;&gt;sharpness ∝ 1 / uncertainty&lt;br&gt;Wide interval → split weight across both children&lt;br&gt;K = 180 trees · balanced bootstrap · r&lt;sub style=&quot;&quot;&gt;sub&lt;/sub&gt; = 70%&lt;/font&gt;&lt;/div&gt;" vertex="1">
          <mxGeometry height="115" width="215" x="757" y="142" as="geometry" />
        </mxCell>
        <mxCell id="2Eg8ceEiwQ1pqdhiCGCj-22" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#6A1B9A;strokeColor=#4A148C;fontColor=#FFFFFF;fontSize=11;align=center;verticalAlign=middle;labelBackgroundColor=none;" value="&lt;font style=&quot;font-size: 12px;&quot;&gt;Two-stage DE: θ = (α&lt;sub&gt;L&lt;/sub&gt;, α&lt;sub&gt;U&lt;/sub&gt;, η, d&lt;sub&gt;max&lt;/sub&gt;, n&lt;sub&gt;min&lt;/sub&gt;)&lt;br&gt;Fitness: L&lt;sub&gt;class&lt;/sub&gt; + 0.2·MPIW + 2.0·coverage gap&lt;br&gt;Run once on Fold 1 → θ* frozen for all folds&lt;/font&gt;" vertex="1">
          <mxGeometry height="95" width="208" x="762" y="265" as="geometry" />
        </mxCell>
        <mxCell id="2Eg8ceEiwQ1pqdhiCGCj-23" parent="1" style="text;html=1;align=center;verticalAlign=middle;fontSize=10;fontStyle=1;fontColor=#4A148C;strokeColor=none;fillColor=none;labelBackgroundColor=none;" value="&lt;font style=&quot;font-size: 11px;&quot;&gt;θ* = (α&lt;sub&gt;L&lt;/sub&gt;=0.0555, α&lt;sub&gt;U&lt;/sub&gt;=0.9384,&amp;nbsp;&lt;/font&gt;&lt;div&gt;&lt;font style=&quot;font-size: 11px;&quot;&gt;η=0.2869, d&lt;sub&gt;max&lt;/sub&gt;=6, n&lt;sub&gt;min&lt;/sub&gt;=33)&lt;/font&gt;&lt;/div&gt;" vertex="1">
          <mxGeometry height="58" width="190" x="770" y="361" as="geometry" />
