        <mxCell id="Zf-mfrk1IAalhlhRQDIb-67" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ECEFF1;strokeColor=#455A64;strokeWidth=1.5;fontSize=11;align=center;spacingLeft=12;fontColor=#263238;" value="&lt;div style=&quot;&quot;&gt;&lt;b style=&quot;font-size: 21px; background-color: transparent; color: light-dark(rgb(38, 50, 56), rgb(188, 198, 203)); line-height: 100%;&quot;&gt;Trapezoid construction (Phase 2 equations):&lt;/b&gt;&lt;/div&gt;&lt;font style=&quot;font-size: 21px;&quot;&gt;a = q&lt;sup style=&quot;&quot;&gt;L&lt;/sup&gt;&lt;sub style=&quot;&quot;&gt;ij,&amp;nbsp;&lt;/sub&gt;d = q&lt;sup style=&quot;&quot;&gt;U&lt;/sup&gt;&lt;sub style=&quot;&quot;&gt;ij,&amp;nbsp;&lt;/sub&gt;b = max( a,  q&lt;sup style=&quot;&quot;&gt;M&lt;/sup&gt; − η·(q&lt;sup style=&quot;&quot;&gt;U&lt;/sup&gt;−q&lt;sup style=&quot;&quot;&gt;L&lt;/sup&gt;) ), c = min( d,  q&lt;sup style=&quot;&quot;&gt;M&lt;/sup&gt; + η·(q&lt;sup style=&quot;&quot;&gt;U&lt;/sup&gt;−q&lt;sup style=&quot;&quot;&gt;L&lt;/sup&gt;) ), centroid = (a+b+c+d) / 4, uncertainty = d − a&lt;br&gt;sharpness = 5 / (uncertainty + t&lt;sub style=&quot;&quot;&gt;width&lt;/sub&gt; + ε)&lt;/font&gt;" vertex="1">
          <mxGeometry height="150" width="1140" x="270" y="769" as="geometry" />
        </mxCell>
        <mxCell id="Zf-mfrk1IAalhlhRQDIb-68" parent="1" style="text;html=1;align=center;fontSize=10;fontColor=#546E7A;strokeColor=none;fillColor=none;fontStyle=2;" value="&lt;font style=&quot;font-size: 18px;&quot;&gt;Left: q&lt;sup style=&quot;&quot;&gt;L&lt;/sup&gt;=2.0, q&lt;sup style=&quot;&quot;&gt;M&lt;/sup&gt;=5.0, q&lt;sup style=&quot;&quot;&gt;U&lt;/sup&gt;=8.0, η=0.15  →  (a,b,c,d)=(2.0, 4.1, 5.9, 8.0),  uncertainty=6.0,  sharpness≈0.83  →  diffuse routing&lt;br&gt;Right: q&lt;sup style=&quot;&quot;&gt;L&lt;/sup&gt;=4.5, q&lt;sup style=&quot;&quot;&gt;M&lt;/sup&gt;=5.0, q&lt;sup style=&quot;&quot;&gt;U&lt;/sup&gt;=5.5, η=0.40  →  (a,b,c,d)=(4.5, 4.6, 5.4, 5.5),  uncertainty=1.0,  sharpness≈5.0  →  deterministic routing&lt;/font&gt;" vertex="1">
          <mxGeometry height="70" width="1520" x="50" y="936" as="geometry" />
        </mxCell>
