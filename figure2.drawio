        <mxCell id="Zf-mfrk1IAalhlhRQDIb-63" parent="1" style="text;html=1;align=center;fontSize=10;fontColor=#880E4F;strokeColor=none;fillColor=none;" value="&lt;font style=&quot;font-size: 15px;&quot;&gt;centroid = (a+b+c+d)/4 = 5.0&lt;/font&gt;" vertex="1">
          <mxGeometry height="16" width="240" x="1100" y="500" as="geometry" />
        </mxCell>
        <mxCell id="Zf-mfrk1IAalhlhRQDIb-64" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E8F5E9;strokeColor=#2E7D32;strokeWidth=2;fontSize=11;align=center;fontColor=#1B5E20;" value="&lt;font style=&quot;font-size: 18px;&quot;&gt;sharpness = 5 / (1.0 + t&lt;sub style=&quot;&quot;&gt;width&lt;/sub&gt; + ε)  ≈ &lt;b style=&quot;&quot;&gt;5.0&lt;/b&gt;&lt;br&gt;→ steep sigmoid → &lt;b style=&quot;&quot;&gt;near-deterministic split&lt;/b&gt;&lt;br&gt;→ crisp routing, high leaf purity&lt;br&gt;→ low output entropy&lt;/font&gt;" vertex="1">
